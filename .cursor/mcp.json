{
    "mcpServers": {
        "figma": {
            "url": "https://mcp.figma.com/mcp",
            "type": "streamable-http"
        },
        "stitch": {
            "command": "npx",
            "args": ["-y", "stitch-mcp"],
            "env": {
                "GOOGLE_CLOUD_PROJECT": "YOUR_PROJECT_ID"
            }
        }
    }
}