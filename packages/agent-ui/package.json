{
	"name": "@ech/agent-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"*.css",
		"**/*.css"
	],
	"exports": {
		".": "./src/index.ts",
		"./chat": "./src/chat.tsx",
		"./mascot": "./src/mascot.tsx",
		"./styles.css": "./src/styles.css"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ./src",
		"test": "vitest run"
	},
	"dependencies": {
		"@assistant-ui/react": "^0.15.22",
		"@ech/agent-core": "file:../agent-core"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	}
}
