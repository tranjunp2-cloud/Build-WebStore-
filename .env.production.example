# PrimeWeb — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Source of truth for production env var NAMES.
# Real values → Vercel Dashboard → Project → Environment Variables.
#
# Adding a new env var:
#   1. Add placeholder here
#   2. gh secret set MY_KEY --body "value"
#   3. Done — auto-synced on next deploy
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=production
APP_ENV=production

# QC-only load-test rate-limit bypass. MUST stay unset/false on production.
# Only activates when APP_ENV=qc-test AND this = 'true' (src/lib/rateLimit.ts). Same for the QC OTP
# bypass below (src/lib/otp/qc-bypass.ts, also needs QC_OTP_BYPASS_CODE).
QC_RATELIMIT_BYPASS_ENABLED=
QC_OTP_BYPASS_ENABLED=
QC_OTP_BYPASS_DOMAIN=

# ── Database ────────────────────────────────────────────────────────────────
# Use the Neon **pooled** host (`-pooler` in the hostname): every server instance opens its own Payload pool,
# and the direct host runs out of connections (Neon max_connections) long before the pooler does.
# scripts/db-setup.js (migrations, runs inside `vercel build`) reads this same DATABASE_URI (fallback DATABASE_URL);
# it has no separate direct-host variable. Its DDL works through the pooler; for a long one-off migration run it
# locally with DATABASE_URI set to the direct host (same URL without `-pooler`).
DATABASE_URI=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Payload pg pool per server instance (src/lib/db/pool-options.ts). Unset = 25 (clamped 1..50).
# Recommended: 10 when DATABASE_URI is the -pooler host.
DATABASE_POOL_MAX=10
# A request waiting for a pool connection fails after this many ms instead of hanging until maxDuration (default 10000).
# 3000 only with Neon autosuspend off (a waking compute needs a few seconds); otherwise leave it unset.
DATABASE_POOL_CONNECT_TIMEOUT_MS=3000
# Optional: Neon read replica(s) for Payload reads (src/lib/payload/read-replicas.ts). Comma-separated list.
# A Neon read replica = a second, read-only compute on the same branch; use ITS -pooler host. Each replica gets its own
# pool per instance with the same DATABASE_POOL_* limits (connections per instance = pool max x (1 + replicas)).
# Writes, transactions, and reads within 2 s of a write on the same instance stay on the primary. Unset = no replicas.
DATABASE_URI_READ_REPLICA=
# Optional legacy fallback, only when DATABASE_URI is unset (same target as Payload):
# DATABASE_URL=postgresql://user:password@host.example.com:5432/database
# QA Migration Recon DB URL (PW1 MySQL Staging/Prod - Read-Only for F40 Migration Recon)
PW1_DATABASE_URL=mysql://qa_readonly:<YOUR_PASSWORD>@host.example.com:3306/primeweb_v1

# ── Payload CMS ────────────────────────────────────────────────────────────
PAYLOAD_SECRET=your-production-payload-secret
PAYLOAD_PUSH_SCHEMA=false
# Optional — peer service's PAYLOAD_SECRET for cross-service SSO JWT verification.
# Set when JWTs issued by a sibling Payload deployment must be accepted here.
SSO_SHARED_SECRET=

# ── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://echprime.com
NEXT_PUBLIC_PLATFORM_DOMAIN=echprime.com
NEXT_PUBLIC_ADMIN_DOMAIN=admin.echprime.com

# ── SSO Integration ──────────────────────────────────────────────────────────
SSO_FORGOT_PASSWORD_URL=https://sso.ecommercehub.my/auth/forgot-password
# Frontend SSO portal (app switcher footer + account settings link). Optional: falls back to the per-env default.
NEXT_PUBLIC_SSO_BASE_URL=https://sso.ecommercehub.unifi.com.my
# Backend API base URL — NOT the frontend portal (NEXT_PUBLIC_SSO_BASE_URL).
SSO_API_BASE_URL=https://sso-api.ecommercehub.my
# Max SSO session requests per minute per outbound IP (flood guard for shared-IP scenarios).
# At events 200 users share 1 WiFi NAT IP → need ≥200. Default 300 (1.5x buffer).
SSO_RATE_LIMIT_PER_MIN=300

# Danh sách các domain an toàn cho phép generate Reset Link (Cách nhau bằng dấu phẩy)
ALLOWED_ORIGINS=https://prime.ecommercehub.my,https://staff.ecommercehub.my

# ── Stripe (LIVE keys) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Xendit (F34) ──────────────────────────────────────────────────────────────
# Source of truth: Vercel Dashboard. Use Xendit LIVE key on production.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# XENDIT_WEBHOOK_URL — local dev only (ngrok/Cloudflare tunnel override).
# Not needed on staging/prod; NEXT_PUBLIC_SERVER_URL is used there instead.
# Set in .env.local only: XENDIT_WEBHOOK_URL=https://your-tunnel.ngrok.io

# ── EasyParcel OAuth 2.0 (F36) ───────────────────────────────────────────────
# Platform app credentials — server-side only, set in Vercel Dashboard.
# Register at EasyParcel Partner Portal → Apps → Create Platform App.
# MANUAL OPS: After registering, set real values in Vercel Dashboard → production env.
EASYPARCEL_CLIENT_ID=
EASYPARCEL_CLIENT_SECRET=
EASYPARCEL_REDIRECT_URI=https://echprime.com/api/easyparcel/oauth-callback
# Webhook shared secret — subscribe in EP Developer Hub with callback URL:
#   https://echprime.com/api/webhooks/easyparcel?secret=<this value>
# Register ALL 3 topics with that URL: Shipment Status Update, Tracking Status
# Update, Shipment AWB Update (AWB Update is REQUIRED — submit can return
# awb_number null and the webhook is the only automatic AWB delivery path).
# Generate: openssl rand -hex 32. Set real value in Vercel Dashboard.
EASYPARCEL_WEBHOOK_SECRET=

# ── Pixabay (AI Gen — Primary Image Source) ────────────────────────────────
# Register at https://pixabay.com/api/docs/ → copy API key
# Free tier ~100 req/60s (≈6000/hr). largeImageURL (1280px) available; full-res
# (fullHDURL/imageURL) needs full-API-access approval.
# Preferred: comma-separated keys are rotated per request. Keep API_KEY for legacy fallback.
PIXABAY_API_KEYS=
PIXABAY_API_KEY=

# ── Google Maps Geocoding (F37 US-01 — Local SEO geo layer 3) ───────────────
# Enable "Geocoding API" in GCP Console → copy API key. OPTIONAL: layers 1-2
# (client regex + redirect-resolver, src/lib/seo/map-links.ts +
# src/app/api/local-seo/resolve-maps-link/route.ts) cover ~90-95% of paste-link
# cases without this key. When absent, the route gracefully skips layer 3 and
# the editor reveals the manual lat/lng disclosure instead — see PRD §13.9/§14.
GOOGLE_MAPS_GEOCODING_API_KEY=

# Feature flag: "true" = DALL-E hero (legacy, $0.04/gen). "false" = Pixabay (free).
# Default false.
ENABLE_DALLE_HERO=false
# Which blocks fetch stock images. "all" = all blocks, "hero" = hero-only.
PIXABAY_BLOCKS=all
# Optional: "1" = skip live search, use only curated fallback URLs.
PIXABAY_FALLBACK_ONLY=
# Gen pipeline mode. "template-first" (default) or "ai-first" (rollback).
GEN_MODE=
# Plan 260703 Phase 05: parallel GPT split (home ∥ subpage batches) to cut
# wall-clock. Default ON — set GEN_PARALLEL_PAGES=false for legacy single call.
GEN_PARALLEL_PAGES=
# Plan 260703 Phase 06: pre-download/upload image-pool photos to media DURING
# the GPT window instead of after it (serialized via GH-1185 media-create-lock).
# Default ON — set GEN_POOL_PREUPLOAD=false for legacy post-GPT upload.
GEN_POOL_PREUPLOAD=
# Optional grace window (ms) for inline blog preparation before deferring
# seeding until after the response. Default 8000; leave unset to use default.
GEN_BLOG_PREP_GRACE_MS=
# Translate raw user keywords → English (gpt-4o-mini) before the Pixabay
# image-pool search (better stock coverage than raw VN/MS terms). Default ON —
# set GEN_TRANSLATE_POOL_KEYWORDS=false for the raw-keyword + VN-gate path (GH-1185).
GEN_TRANSLATE_POOL_KEYWORDS=

# ── S3 / Storage ─────────────────────────────────────────────────────────────
S3_BUCKET=primeweb-media-prod
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-southeast-1
NEXT_PUBLIC_S3_ENDPOINT=${S3_ENDPOINT}

# ── Cloudflare (Custom Domains) ──────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ── Lark Bot ─────────────────────────────────────────────────────────────────
LARK_APP_ID=cli_xxxxx
LARK_APP_SECRET=xxxxx
LARK_ENCRYPT_KEY=xxxxx
LARK_VERIFICATION_TOKEN=xxxxx
LARK_BOT_OPEN_ID=ou_xxxxx
LARK_API_BASE=https://open.larksuite.com/open-apis  # default for Lark; Feishu: https://open.feishu.cn/open-apis

# ── Lark Base: feedback submissions (header Feedback button) ───────────
LARK_BASE_APP_TOKEN=bascnxxxxx
LARK_BASE_REPORT_TABLE_ID=tblxxxxx

# ── Lark group card for feedback (action buttons + daily overdue digest) ──
# Chat id (oc_...) of the group the app bot posts to; unset = no card, feedback still saved.
LARK_NOTIFY_CHAT_ID=oc_xxxxx
# From the app's Events & Callbacks page. The callback URL is /api/v1/feedback/lark-card-action;
# one app has one callback URL. Token is required (unset = every callback refused); encrypt key is optional.
LARK_CALLBACK_VERIFICATION_TOKEN=xxxxx
LARK_CALLBACK_ENCRYPT_KEY=xxxxx

# ── GitHub API ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=primeproduction/ech-prime-web-v2

# ── ECH Distribution API ────────────────────────────────────────────────────
ECH_DISTRIBUTION_API_URL=https://api.ech.com
ECH_DISTRIBUTION_API_KEY=your-ech-api-key

# ── Email (SMTP AWS SES) ─────────────────────────────────────────────────────
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_NAME="PrimeWeb"
MAIL_FROM_ADDRESS="noreply@echprime.com"

# ── Bootstrap Seed (auto-creates essential accounts on startup) ──────────────
BOOTSTRAP_ADMIN_EMAIL=admin@primeweb.app
BOOTSTRAP_ADMIN_PASSWORD=your-strong-admin-password
# Super-admin credentials used by protected E2E specs (CI secrets only)
ADMIN_EMAIL=your-production-super-admin-email
ADMIN_PASSWORD=your-production-super-admin-password
SSO_SERVICE_EMAIL=sso-service@primeweb.app
SSO_SERVICE_PASSWORD=your-strong-sso-password

# ── Cron Jobs ────────────────────────────────────────────────────────────────
CRON_SECRET=your-production-cron-secret
# AES-256 key for encrypting user SSO passwords (keyString field). Generate: openssl rand -hex 32
SSO_ENCRYPTION_KEY=your-production-sso-encryption-key

# ── Web Push Notifications (F16-07) ──────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adminprimeweb@yopmail.com

# ── Upstash Redis (distributed rate limiting + caching) — REQUIRED on staging / production ──
# Rate limits and the shared caches (To do list, SEO work item) live here for every instance. Without both values
# each instance counts / remembers on its own: logged as an error at startup and shown by /api/health?deep=1
# (`rateLimit: "memory (NOT shared)"`). Upstash errors at runtime: limits fail open to memory, outbound email (lead
# replies) fails closed. Each call: 1 retry, 1 s timeout (src/lib/redis.ts).
# Shared caches (To do, SEO work items): memory = per instance (default), redis = Upstash, shared by every
# instance (~2 commands per /api/agent/work poll). Upstash is still used for rate limits either way.
SHARED_CACHE_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Vercel Deploy Webhook ────────────────────────────────────────────────────
VERCEL_WEBHOOK_SECRET=your-vercel-webhook-secret

# ── E2E Testing ──────────────────────────────────────────────────────────────
# NOTE: E2E_TEST_OTP_CODE MUST stay empty in production — bypass disabled (listed so the manifest check sees it)
E2E_TEST_OTP_CODE=
TEST_EMAIL=test@example.com
TEST_PASSWORD=test-password
# E2E OTP bypass opt-in (src/lib/otp/e2e-bypass.ts). MUST stay unset or false in
# production — true would let TEST_EMAIL log in with a fixed code.
E2E_OTP_BYPASS_ENABLED=false
# QA workspace id(s) for the bypass — staging only; keep empty in production.
E2E_OTP_BYPASS_TENANT_ID=
# F40-03 targeted Smoke is staging-only. Keep these empty in production.

# ── QA Control Center (F40) ────────────────────────────────────────────────
# Reserved for a future production QA pipeline; do not expose to browsers.
QA_INGEST_SECRET=your-production-qa-ingest-secret
QA_ARTIFACT_ALLOWED_HOSTS=artifacts.example.com
QA_EVIDENCE_BASE_URL=https://echprime.com
# Reserved for F40-03. Keep disabled in production: automatic targeted Smoke
# is a staging-only control and GitHub App credentials stay server-side.
F40_TARGETED_SMOKE_ENABLED=false
QA_TARGETED_DISPATCH_SECRET=your-production-targeted-smoke-dispatch-secret
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Automatically injected by Vercel; never set a customer-provided value.
VERCEL_GIT_COMMIT_SHA=auto-provided-by-vercel

# ── F19 Vercel Domain Provisioning (replaces DO_API_TOKEN, DO_APP_ID, SERVER_IP) ─
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_H3WAlHhz2xqvIFRcxfWevPTs
VERCEL_PROJECT_ID=prj_84DQ47BSv2hBX28w0FzjFScfbuRr
# F39 Runtime Logs read uses the same team/project IDs above (server-only).
VERCEL_APEX_A_RECORD=76.76.21.21
VERCEL_CNAME_TARGET=cname.vercel-dns.com
NEXT_PUBLIC_VERCEL_APEX_IP=76.76.21.21
NEXT_PUBLIC_VERCEL_CNAME_TARGET=cname.vercel-dns.com
# REMOVED 2026-04-13: SERVER_IP, NEXT_PUBLIC_SERVER_IP, DO_API_TOKEN, DO_APP_ID, NEXT_PUBLIC_CNAME_TARGET

# ── AI Generation Monitoring (Phase 05 Studio) ──────────────────────────────
# Prompt persistence mode: full | truncated | hashed
ADMIN_GEN_CAPTURE_MODE=full
# Max output snapshot size in KB
ADMIN_GEN_SNAPSHOT_MAX_KB=50

# ── Sentry (Error Monitoring + Tracing) ─────────────────────────────────────
# Set in Vercel Dashboard → Settings → Environment Variables → Production
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# F39 runtime read — dedicated least-privilege event:read token (server-only).
SENTRY_READ_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Source-map upload only — set as a GitHub Secret, NOT in Vercel Dashboard.
# SENTRY_AUTH_TOKEN=

# Local PW1 import only; supply privately, never commit real values.
PW1_APP_KEY=

# Local PW1 import only; supply privately, never commit real values.
PW2_MIGRATION_SECRET=

# Optional legacy migration target guard identity (never changes source namespace).
PW2_MIGRATION_TARGET_ID=

# Local-only synthetic migration rehearsal; leave unset in deployed environments.
# Empty placeholders document the variables for CI; they do not enable rehearsal.
# Set DATABASE to an isolated pw1_import_1886_* clone; flags are enabled only by 1.
PW1_TEST_DATABASE=
PW1_TEST_FULL=
PW1_TEST_TWO=
PW1_TEST_V2=
# Exporter 1.2 receipts; implies V2 and requires FULL=1 and TWO=1.
PW1_TEST_V3=
PW1_TEST_INTERRUPT=
# When running rehearsal locally, supply a new private artifact directory explicitly.
PW1_TEST_ARTIFACT=

# ── Firebase RTDB notification signal (F16, #1972) ──────────────────────────
# Realtime "doorbell" for in-app notifications. Server-only; leave EMPTY to
# disable (clients fall back to 60s polling). Values from Firebase Console:
#   Project settings -> Service accounts -> Generate new private key (3 vars)
#   Project settings -> General -> Your apps -> Web app -> apiKey
#   Realtime Database -> database URL
# FIREBASE_PRIVATE_KEY: paste the key with literal \n sequences, no quotes (Vercel).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_WEB_API_KEY=
# ── Upstash Redis (distributed rate limiting, incl. the AI copilot limits) ─────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── ECH AI Platform (services/ai-platform) — the only service that calls models ──
# Server-side only: the browser reaches it through the /api/agent BFF (never NEXT_PUBLIC_*).
# Base URL of the separately deployed ai-platform Vercel project, no trailing slash.
# Unset = AI features stay off.
AI_PLATFORM_URL=
# Shared with services/ai-platform (same name there); signs the short-lived context token. >=32 chars.
AI_PLATFORM_CONTEXT_SECRET=
# Mascot copilot switch: unset = on outside production; "false" = off everywhere (kill switch); production needs "true".
AI_AGENT_ENABLED=false
# AI spend caps are edited in Prime Studio (AI usage). These two only feed its status view and the cap alerts:
# daily cap used while Studio has none saved; keep equal to AI_DAILY_BUDGET_USD of services/ai-platform. Unset = 20, 0 = off.
AI_DAILY_BUDGET_USD=
# Lark custom-bot webhook for "AI spend crossed N%" messages. Optional: unset = alerts are only recorded (Payload ai-cap-alerts, Studio).
LARK_WEBHOOK_AI_ALERTS=
# Which copilot abilities are on is set in the AI platform project (services/ai-platform), not here. Value for this release:
#   AI_AGENT_CAPABILITIES=site,blog,stock_photos,media_library,image_generation,shop_products,store_categories,store_discounts,store_customers,campaigns,store_orders,store_reports
# stock_photos needs PIXABAY_API_KEY(S) in this app; image_generation needs the platform's image model and daily limit;
# the platform's PRIME_WEB_INTERNAL_URL must point at this app. shop_products cannot be mixed with product_master / store_products.
