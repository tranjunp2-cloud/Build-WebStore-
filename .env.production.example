# ── PrimeWeb Production Environment ──────────────────────────────────────
# Copy this to .env and fill in real values before production deploy
# ─────────────────────────────────────────────────────────────────────────

# Database
DB_PASSWORD=your-strong-db-password-here

# Payload CMS
PAYLOAD_SECRET=your-super-secret-payload-key-change-this

# URLs
NEXT_PUBLIC_SERVER_URL=https://primeweb.app
NEXT_PUBLIC_PLATFORM_DOMAIN=primeweb.app

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OpenAI
OPENAI_API_KEY=sk-...

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_BUCKET=primeweb-media
S3_ACCESS_KEY_ID=your-minio-access-key
S3_SECRET_ACCESS_KEY=your-minio-secret-key
S3_REGION=ap-southeast-1
