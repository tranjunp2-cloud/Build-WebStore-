# PrimeWeb — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Source of truth for production env var NAMES.
# Real values → GitHub Secrets → auto-synced to DO on deploy.
#
# Adding a new env var:
#   1. Add placeholder here
#   2. gh secret set MY_KEY --body "value"
#   3. Done — auto-synced on next deploy
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=production

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Payload CMS ────────────────────────────────────────────────────────────
PAYLOAD_SECRET=your-production-payload-secret
PAYLOAD_PUSH_SCHEMA=false

# ── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://echprime.com
NEXT_PUBLIC_PLATFORM_DOMAIN=echprime.com
NEXT_PUBLIC_APP_URL=https://echprime.com

# ── SSO Integration ──────────────────────────────────────────────────────────
SSO_FORGOT_PASSWORD_URL=https://sso.ecommercehub.my/auth/forgot-password

# ── Stripe (LIVE keys) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── OpenAI (AI Generation) ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── S3 / Storage ─────────────────────────────────────────────────────────────
S3_BUCKET=primeweb-media-prod
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-southeast-1

# ── Cloudflare (Custom Domains) ──────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ── Lark Bot ─────────────────────────────────────────────────────────────────
LARK_APP_ID=cli_xxxxx
LARK_APP_SECRET=xxxxx
LARK_ENCRYPT_KEY=xxxxx
LARK_VERIFICATION_TOKEN=xxxxx
LARK_BOT_OPEN_ID=ou_xxxxx

# ── GitHub API ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=primeproduction/ech-prime-web-v2

# ── ECH Distribution API ────────────────────────────────────────────────────
ECH_DISTRIBUTION_API_URL=https://api.ech.com
ECH_DISTRIBUTION_API_KEY=your-ech-api-key

# ── Email (SMTP AWS SES) ─────────────────────────────────────────────────────
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_NAME="PrimeWeb"
MAIL_FROM_ADDRESS="noreply@echprime.com"

# ── Bootstrap Seed (auto-creates essential accounts on startup) ──────────────
BOOTSTRAP_ADMIN_EMAIL=admin@primeweb.app
BOOTSTRAP_ADMIN_PASSWORD=your-strong-admin-password
SSO_SERVICE_EMAIL=sso-service@primeweb.app
SSO_SERVICE_PASSWORD=your-strong-sso-password

# ── E2E Testing ──────────────────────────────────────────────────────────────
# NOTE: E2E_TEST_OTP_CODE intentionally NOT set in production — bypass disabled
TEST_EMAIL=test@example.com
TEST_PASSWORD=test-password
