{
  "schemaVersion": 1,
  "name": "wix-pro-v1.1",
  "description": "Stricter Wix-professional rubric. 8 dims, 47 criteria, weight 79. Tightens ceiling issues in v1 (typography/spacing/density always 10) and adds 11 new measurable criteria (headline length, CTA pair, footer columns, content depth, etc.).",
  "thresholds": {
    "pass": 7,
    "warn": 5
  },
  "dimensions": [
    {
      "id": "visual-richness",
      "name": "Visual Richness",
      "weight": 12,
      "description": "Visual variety — decorative blocks, imagery, variant diversity, icon usage.",
      "criteria": [
        {
          "id": "hero-variant-diverse",
          "label": "Hero uses non-default variant",
          "check": { "type": "enum", "blockType": "hero", "field": "variant", "in": ["split-image", "fullscreen", "video-bg", "overlay", "centered", "split-text-image", "gradient-bg"] },
          "passPoints": 3
        },
        {
          "id": "gallery-present",
          "label": "Gallery / portfolio block present",
          "check": { "type": "presence", "blockType": "gallery,gallery-masonry,portfolio-grid" },
          "passPoints": 2
        },
        {
          "id": "stats-present",
          "label": "Stats block present",
          "check": { "type": "presence", "blockType": "stats" },
          "passPoints": 2
        },
        {
          "id": "logo-cloud-present",
          "label": "Logo Cloud / Trust Bar present",
          "check": { "type": "presence", "blockType": "client-logos,logo-cloud" },
          "passPoints": 2
        },
        {
          "id": "image-coverage",
          "label": "Gallery present OR hero has non-SVG background image",
          "check": { "type": "custom", "evaluator": "imageCoverage" },
          "passPoints": 3
        },
        {
          "id": "features-have-icons",
          "label": "Icon-variant features have icon field ≥70%",
          "check": { "type": "custom", "evaluator": "featuresHaveIcons" },
          "passPoints": 2
        }
      ]
    },
    {
      "id": "typography-hierarchy",
      "name": "Typography Hierarchy",
      "weight": 12,
      "description": "Font pairing, headline length quality, subheadline richness, section coverage.",
      "criteria": [
        {
          "id": "hero-headline-present",
          "label": "Hero has non-empty headline",
          "check": { "type": "custom", "evaluator": "heroHasHeadline" },
          "passPoints": 2
        },
        {
          "id": "single-hero",
          "label": "Exactly 1 hero block",
          "check": { "type": "custom", "evaluator": "singleHero" },
          "passPoints": 2
        },
        {
          "id": "theme-heading-body-distinct",
          "label": "Theme defines distinct heading + body fonts",
          "check": { "type": "custom", "evaluator": "themeHeadingBodyDistinct" },
          "passPoints": 2
        },
        {
          "id": "hero-subheadline",
          "label": "Hero has subheadline",
          "check": { "type": "custom", "evaluator": "heroHasSubheadline" },
          "passPoints": 1
        },
        {
          "id": "section-headlines-coverage-85",
          "label": "≥85% content blocks have headline/sectionLabel",
          "check": { "type": "custom", "evaluator": "sectionHeadlinesCoverage85" },
          "passPoints": 2
        },
        {
          "id": "hero-headline-length-ideal",
          "label": "Hero headline 15-80 chars (partial 10-14 or 81-120)",
          "check": { "type": "custom", "evaluator": "heroHeadlineLengthIdeal" },
          "passPoints": 2
        },
        {
          "id": "hero-subheadline-length",
          "label": "Hero subheadline 30-200 chars",
          "check": { "type": "custom", "evaluator": "heroSubheadlineLength" },
          "passPoints": 1
        }
      ]
    },
    {
      "id": "social-proof",
      "name": "Social Proof & Trust",
      "weight": 10,
      "description": "Testimonials, logos, stats, ratings.",
      "criteria": [
        {
          "id": "testimonials-present",
          "label": "Testimonials block present",
          "check": { "type": "presence", "blockType": "testimonials" },
          "passPoints": 2
        },
        {
          "id": "testimonials-count-3plus",
          "label": "Testimonials ≥3 items",
          "check": { "type": "count", "blockType": "testimonials", "field": "testimonials", "min": 3 },
          "passPoints": 2
        },
        {
          "id": "logos-count-4plus",
          "label": "Logo cloud ≥4 logos",
          "check": { "type": "count", "blockType": "client-logos,logo-cloud", "field": "logos", "min": 4 },
          "passPoints": 2
        },
        {
          "id": "stats-count-3plus",
          "label": "Stats ≥3 items",
          "check": { "type": "count", "blockType": "stats", "field": "stats", "min": 3 },
          "passPoints": 2
        },
        {
          "id": "testimonial-avatar",
          "label": "≥1 testimonial has avatar URL",
          "check": { "type": "custom", "evaluator": "testimonialHasAvatar" },
          "passPoints": 2
        },
        {
          "id": "testimonials-have-ratings",
          "label": "≥50% testimonials have rating field",
          "check": { "type": "custom", "evaluator": "testimonialsHaveRatings" },
          "passPoints": 2
        }
      ]
    },
    {
      "id": "micro-interactions",
      "name": "Micro-Interactions",
      "weight": 9,
      "description": "Nav variant, CTA blocks, forms, variety — proxy for interaction richness.",
      "criteria": [
        {
          "id": "nav-variant-rich",
          "label": "Nav non-basic variant",
          "check": { "type": "enum", "blockType": "navigation", "field": "variant", "in": ["centered", "mega-menu", "transparent", "sidebar"] },
          "passPoints": 2
        },
        {
          "id": "cta-block-present",
          "label": "Standalone CTA block present",
          "check": { "type": "presence", "blockType": "cta" },
          "passPoints": 2
        },
        {
          "id": "interactive-form",
          "label": "Newsletter or contact form present",
          "check": { "type": "presence", "blockType": "newsletter,contact" },
          "passPoints": 2
        },
        {
          "id": "block-variety-8plus",
          "label": "≥8 distinct block types",
          "check": { "type": "custom", "evaluator": "distinctBlockTypes8" },
          "passPoints": 2
        },
        {
          "id": "nav-links-balanced",
          "label": "Nav has 3-7 links (not cluttered, not sparse)",
          "check": { "type": "custom", "evaluator": "navLinksBalanced" },
          "passPoints": 1
        }
      ]
    },
    {
      "id": "spacing-rhythm",
      "name": "Spacing & Rhythm",
      "weight": 10,
      "description": "Block count sweet spot, theme design tokens (spacing + radius + shadow).",
      "criteria": [
        {
          "id": "block-count-sweet-spot",
          "label": "Homepage 9-14 blocks (partial 7-8 or 15-16)",
          "check": { "type": "custom", "evaluator": "blockCountSweetSpot" },
          "passPoints": 4,
          "partialPoints": 2
        },
        {
          "id": "no-consecutive-duplicates",
          "label": "No 2 adjacent blocks same type",
          "check": { "type": "custom", "evaluator": "noConsecutiveDuplicates" },
          "passPoints": 2
        },
        {
          "id": "theme-has-spacing-preset",
          "label": "Theme spacingPreset defined",
          "check": { "type": "custom", "evaluator": "themeHasSpacingPreset" },
          "passPoints": 1
        },
        {
          "id": "theme-has-border-radius",
          "label": "Theme borderRadius defined",
          "check": { "type": "custom", "evaluator": "themeHasBorderRadius" },
          "passPoints": 1
        },
        {
          "id": "theme-has-shadow-preset",
          "label": "Theme shadowPreset defined",
          "check": { "type": "custom", "evaluator": "themeHasShadowPreset" },
          "passPoints": 2
        }
      ]
    },
    {
      "id": "conversion-path",
      "name": "Conversion Path Clarity",
      "weight": 10,
      "description": "Multi-placement CTA, form lead capture, dual CTA, specific CTA copy.",
      "criteria": [
        {
          "id": "hero-has-cta",
          "label": "Hero has CTA button",
          "check": { "type": "custom", "evaluator": "heroHasCta" },
          "passPoints": 2
        },
        {
          "id": "mid-cta-present",
          "label": "Mid-page CTA block present",
          "check": { "type": "presence", "blockType": "cta" },
          "passPoints": 2
        },
        {
          "id": "contact-present",
          "label": "Contact block present (any page)",
          "check": { "type": "presence", "blockType": "contact" },
          "passPoints": 2
        },
        {
          "id": "newsletter-present",
          "label": "Newsletter lead capture",
          "check": { "type": "presence", "blockType": "newsletter" },
          "passPoints": 1
        },
        {
          "id": "nav-has-cta",
          "label": "Nav has CTA button",
          "check": { "type": "custom", "evaluator": "navHasCta" },
          "passPoints": 1
        },
        {
          "id": "hero-cta-pair",
          "label": "Hero has ≥2 CTAs (primary + secondary)",
          "check": { "type": "custom", "evaluator": "heroCtaPair" },
          "passPoints": 1
        },
        {
          "id": "cta-text-quality-specific",
          "label": "CTAs avoid all-generic labels (Click Here / Learn More / Read More)",
          "check": { "type": "custom", "evaluator": "ctaTextQualitySpecific" },
          "passPoints": 1
        }
      ]
    },
    {
      "id": "content-authenticity",
      "name": "Content Authenticity",
      "weight": 8,
      "description": "Zero Lorem, substantive copy, category depth.",
      "criteria": [
        {
          "id": "no-lorem-strict",
          "label": "No 'Lorem Ipsum' or placeholder copy anywhere",
          "check": { "type": "custom", "evaluator": "noLoremStrict" },
          "passPoints": 2
        },
        {
          "id": "hero-headline-substantial",
          "label": "Hero headline ≥10 chars",
          "check": { "type": "custom", "evaluator": "heroHeadlineSubstantial" },
          "passPoints": 1
        },
        {
          "id": "features-count-3plus",
          "label": "Features block ≥3 items",
          "check": { "type": "count", "blockType": "features", "field": "features", "min": 3 },
          "passPoints": 2
        },
        {
          "id": "faq-count-4plus",
          "label": "FAQ ≥4 items",
          "check": { "type": "count", "blockType": "faq", "field": "items", "min": 4 },
          "passPoints": 2
        },
        {
          "id": "content-depth",
          "label": "Hero copy + section labels total ≥300 chars",
          "check": { "type": "custom", "evaluator": "contentDepth300" },
          "passPoints": 2
        }
      ]
    },
    {
      "id": "information-density",
      "name": "Information Density",
      "weight": 8,
      "description": "Block count balance, type variety ≥60%, footer structure.",
      "criteria": [
        {
          "id": "block-count-min-7",
          "label": "Homepage ≥7 blocks",
          "check": { "type": "custom", "evaluator": "blockCountMin7" },
          "passPoints": 1
        },
        {
          "id": "block-count-max-16",
          "label": "Homepage ≤16 blocks",
          "check": { "type": "custom", "evaluator": "blockCountMax16" },
          "passPoints": 2
        },
        {
          "id": "variety-unique-75",
          "label": "Distinct block types ≥75% of total",
          "check": { "type": "custom", "evaluator": "varietyUnique75" },
          "passPoints": 3
        },
        {
          "id": "footer-mega-columns",
          "label": "Footer mega variant ≥4 link columns",
          "check": { "type": "custom", "evaluator": "footerMegaColumns" },
          "passPoints": 3
        }
      ]
    }
  ]
}
