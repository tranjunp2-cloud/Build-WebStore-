{
  "version": 5,
  "contract": {
    "inputs": [
      "parsed product name",
      "model-returned category id",
      "tenant-scoped category candidates with trusted id and path"
    ],
    "excludedEvidence": [
      "description",
      "seoTitle",
      "seoDescription",
      "sku",
      "variants",
      "merchant prompt",
      "model confidence"
    ],
    "reasons": [
      "matched",
      "modelNull",
      "unknownId",
      "semanticRejected",
      "ambiguous"
    ],
    "output": {
      "categoryId": "the canonical tenant candidate id or null",
      "reason": "exactly one value from contract.reasons"
    },
    "normalization": [
      "Unicode NFKD",
      "diacritic removal",
      "lowercase",
      "punctuation to spaces",
      "fail closed when character or token bounds are exceeded"
    ],
    "bounds": {
      "productNameMaxChars": 120,
      "categoryPathMaxChars": 240,
      "maxTokensPerValue": 32,
      "minimumIdentityTokenLength": 3
    },
    "noiseTokens": {
      "generic": ["category", "categories", "general", "item", "items", "product", "products"],
      "qa": ["qa", "test", "testing"],
      "materials": ["cotton", "fabric", "leather", "metal", "plastic", "steel", "wood", "wooden"],
      "colors": ["black", "blue", "brown", "green", "grey", "gray", "orange", "pink", "purple", "red", "white", "yellow"],
      "sizes": ["xs", "small", "medium", "large", "xl", "xxl"],
      "brandLike": ["brand", "official"],
      "meta": ["color", "generic", "material", "number", "size"],
      "reviewedModifiers": ["running"],
      "numeric": ["tokens containing only ASCII digits"]
    },
    "pluralRules": [
      "singularize only exact entries in reviewedPluralTokens; unlisted words remain unchanged"
    ],
    "reviewedPluralTokens": {
      "bags": "bag", "books": "book", "bottles": "bottle", "boxes": "box",
      "bracelets": "bracelet", "carpets": "carpet", "cases": "case", "categories": "category",
      "chairs": "chair", "coats": "coat", "colors": "color", "cups": "cup",
      "dresses": "dress", "hats": "hat", "items": "item", "jackets": "jacket",
      "lamps": "lamp", "materials": "material", "mugs": "mug", "necklaces": "necklace",
      "numbers": "number", "phones": "phone", "products": "product", "rings": "ring",
      "sandals": "sandal", "shirts": "shirt", "shoes": "shoe", "sizes": "size",
      "skirts": "skirt", "sofas": "sofa", "socks": "sock", "tables": "table",
      "tests": "test", "toys": "toy", "wallets": "wallet", "watches": "watch"
    },
    "equivalences": [],
    "contextualHeadEquivalences": [
      {
        "productHead": "serum",
        "candidateTokens": ["skincare"],
        "requiredProductTokens": ["skin"],
        "allowedProductTokens": ["skin", "serum", "vitamin"],
        "allowedProductShortTokens": ["c"]
      }
    ],
    "identityRules": [
      "remove only the finite noiseTokens listed in this contract",
      "preserve non-noise short identity tokens when at least one longer identity token exists; reject short-token-only identities",
      "allow exact overlap only when the complete normalized product and candidate identity token sets are equal",
      "do not allow unrestricted token equivalences",
      "require exact equality between normalized product and candidate leaf identity-token sets",
      "allow only finite directional contextual rules with exact candidate tokens, required product tokens, and allowed product tokens",
      "allow only the pluralRules listed in this contract",
      "allow only the explicit equivalences listed in this contract",
      "never use arbitrary prefix, substring, edit-distance, or fuzzy matching",
      "treat finite material, color, size, and numeric qualifiers as insufficient positive evidence",
      "reject a match when both sides contain conflicting values in the same finite qualifier group",
      "retain the proposed allowlisted id only when it is the unique plausible candidate"
    ]
  },
