{
  "version": 7,
  "contract": {
    "inputs": [
      "model-returned category id",
      "tenant-scoped active category candidates with trusted id and breadcrumb path"
    ],
    "excludedEvidence": [
      "generated product name",
      "description",
      "seoTitle",
      "seoDescription",
      "sku",
      "variants",
      "merchant prompt",
      "model confidence"
    ],
    "reasons": [
      "matched",
      "modelNull",
      "unknownId",
      "semanticRejected",
      "ambiguous"
    ],
    "output": {
      "categoryId": "the canonical tenant candidate id or null",
      "reason": "matched, modelNull, or unknownId; legacy reason values remain response-compatible"
    },
    "semanticAuthority": [
      "the AI chooses category semantics from the complete tenant candidate list and breadcrumb paths",
      "the merchant reviews every generated draft before save",
      "the server enforces tenant membership and save-time validity, not semantic similarity"
    ],
    "guardRules": [
      "preserve a model-proposed id only when it canonicalizes to a supplied tenant candidate id",
      "preserve model null without server-side semantic inference",
      "reject unknown ids without falling back to another candidate",
      "never reinterpret category semantics from the generated product name"
    ]
  },
  "cases": [
    {
