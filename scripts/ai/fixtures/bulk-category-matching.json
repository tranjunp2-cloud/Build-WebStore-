      "productName": "Cooking Oil",
      "candidates": [
        {
          "id": "category-oil",
          "path": "Food > Cooking Ingredients > Oil"
        }
      ],
      "proposedCategoryId": "category-oil",
      "expectedCategoryId": "category-oil",
      "expectedReason": "matched"
    },
    {
      "id": "allowlisted-essential-oil-to-oil",
      "productName": "Essential Oil",
      "candidates": [
        {
          "id": "category-oil",
          "path": "Wellness > Oil"
        }
