{
  "name": "prime-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "cross-env NODE_OPTIONS=\"--require ./node-polyfill.js\" next dev --turbopack",
    "build": "cross-env NODE_OPTIONS=\"--require ./node-polyfill.js\" next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky || true",
    "generate:types": "payload generate:types",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "db:push": "node scripts/db-push-once.js",
    "db:migrate": "node --require ./scripts/seed-preload.cjs scripts/db-setup.js --migrate-only",
    "db:seed": "tsx --require ./scripts/seed-preload.cjs scripts/seed.ts",
    "db:seed-sso": "tsx --require ./scripts/seed-preload.cjs scripts/seed-sso-account.ts",
    "db:reset": "tsx --require ./scripts/seed-preload.cjs scripts/reset-account.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "drift:check": "vitest run src/__tests__/unit/ai/template-drift-validator.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit",
    "harness:gen": "tsx scripts/test-harness/cli.ts --mode=full",
    "harness:quick": "tsx scripts/test-harness/cli.ts --mode=quick",
    "harness:check": "tsx scripts/test-harness/check.ts",
    "harness:render": "playwright test --config=scripts/test-harness/render/playwright.config.ts",
    "harness:merge": "tsx scripts/test-harness/render/visual-report.ts",
    "harness:report": "tsx scripts/test-harness/report/generate.ts",
    "harness:score": "tsx scripts/test-harness/rubric/scorer.ts",
    "measure:variety": "tsx scripts/measure-variety.ts",
    "harness:all": "tsx scripts/test-harness/cli.ts --mode=full && tsx scripts/test-harness/check.ts && (playwright test --config=scripts/test-harness/render/playwright.config.ts || true) && tsx scripts/test-harness/render/visual-report.ts; tsx scripts/test-harness/report/generate.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.1.0",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/lib-storage": "^3.1020.0",
    "@ckeditor/ckeditor5-react": "^11.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@mozilla/readability": "^0.6.0",
    "@payloadcms/db-postgres": "3.79.0",
    "@payloadcms/email-nodemailer": "3.79.0",
    "@payloadcms/next": "3.79.0",
    "@payloadcms/plugin-cloud-storage": "3.79.0",
    "@payloadcms/richtext-lexical": "3.79.0",
    "@payloadcms/storage-s3": "3.79.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@tiptap/extension-image": "^3.22.1",
    "@tiptap/extension-link": "^3.22.1",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/extension-underline": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/react": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "@types/nodemailer": "^7.0.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^4.1.0",
    "cheerio": "^1.2.0",
    "ckeditor5": "^48.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.0",
    "framer-motion": "^11.12.0",
    "franc-min": "^6.2.0",
    "graphql": "^16.13.1",
    "isomorphic-dompurify": "~2.26.0",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.8",
    "next": "15.4.11",
    "nodemailer": "^8.0.3",
    "open-graph-scraper": "^6.11.0",
    "openai": "^4.77.0",
    "payload": "3.79.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.8.0",
    "sharp": "^0.33.0",
    "slugify": "^1.6.6",
    "sonner": "^1.7.0",
    "stripe": "^17.0.0",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.4.11",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
