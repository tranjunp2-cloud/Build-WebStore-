{
  "name": "prime-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "cross-env NODE_OPTIONS=\"--require ./node-polyfill.js\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--require ./node-polyfill.js\" next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky || true",
    "generate:types": "payload generate:types",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
    "db:push": "node scripts/db-push-once.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.1.0",
    "@hookform/resolvers": "^3.9.0",
    "@payloadcms/db-postgres": "^3.14.0",
    "@payloadcms/next": "^3.14.0",
    "@payloadcms/plugin-cloud-storage": "^3.14.0",
    "@payloadcms/richtext-lexical": "^3.14.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.62.0",
    "ai": "^4.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.8",
    "next": "15.4.11",
    "openai": "^4.77.0",
    "payload": "^3.14.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.33.0",
    "slugify": "^1.6.6",
    "sonner": "^1.7.0",
    "stripe": "^17.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.4.11",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
