{
	"name": "@ech/ai-platform",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "ECH AI Platform — the only service that calls models (task engine, agent runs, change sets, usage ledger).",
	"engines": {
		"node": "24.x"
	},
	"overrides": {
		"fastify": "5.12.7"
	},
	"scripts": {
		"build": "tsup",
		"build:vercel": "tsup && node scripts/vercel-build.mjs",
		"dev": "tsup --watch --onSuccess \"node --enable-source-maps dist/main.js\"",
		"start": "node --enable-source-maps dist/main.js",
		"db:migrate": "tsup && node dist/migrate.js",
		"usage:report": "tsup && node dist/usage-report.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.82",
		"@ai-sdk/deepseek": "3.0.67",
		"@ai-sdk/google": "^4.0.99",
		"@ai-sdk/openai": "^4.0.96",
		"@ai-sdk/openai-compatible": "^3.0.71",
		"@ech/agent-core": "file:../../packages/agent-core",
		"@ech/ai-contracts": "file:../../packages/ai-contracts",
		"@nestjs/common": "^11.1.27",
		"@nestjs/core": "^11.1.27",
		"@nestjs/platform-fastify": "^11.2.7",
		"ai": "^7.0.143",
		"dotenv": "^17.2.3",
		"drizzle-orm": "0.45.2",
		"fastify": "5.12.7",
		"jose": "5.9.6",
		"pg": "^8.17.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@swc/core": "^1.15.3",
		"@types/node": "^24.10.2",
		"@types/pg": "^8.15.6",
		"tsup": "^9.0.0",
		"typescript": "5.9.2",
		"unplugin-swc": "^1.5.9",
		"vitest": "^3.2.6"
	}
}
