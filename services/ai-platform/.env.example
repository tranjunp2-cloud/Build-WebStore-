# ── ECH AI Platform ─────────────────────────────────────────────
# The only service that calls models. prime-web reaches it server-side
# through /api/agent (BFF); browsers never talk to it directly.

PORT=8300

# Own database — never commerce_core / primeweb.
AI_PLATFORM_DATABASE_URL=postgres://user:password@localhost:5434/ai_platform

# Shared with prime-web (AI_PLATFORM_CONTEXT_SECRET). Signs the short-lived
# context token (org, tenant, user) on every request. ≥32 chars.
AI_PLATFORM_CONTEXT_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Provider keys — set only the providers you use. With Cloudflare AI Gateway
# + BYOK (keys stored in the gateway) leave them empty and set AI_GATEWAY_TOKEN.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Cloudflare AI Gateway (optional; unset = call the provider directly).
# Format: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>
AI_GATEWAY_BASE_URL=
# Authenticated gateway token (sent as cf-aig-authorization).
AI_GATEWAY_TOKEN=

# Model aliases — features never name models directly. Each alias is a
# fallback chain "provider:model, provider:model…"; providers without
# credentials here are skipped, outages (429/5xx/timeout) fall to the next.
# Providers: openai | anthropic | google | openrouter | deepseek | compat-<name> | mock
AI_MODEL_FAST=openai:gpt-4.1-nano, google:gemini-2.5-flash-lite
AI_MODEL_BALANCED=openai:gpt-4.1-mini, anthropic:claude-haiku-4-5
# Site generation tier (prime-web builder, PW1 migration).
AI_MODEL_QUALITY=openai:gpt-5.4-mini

# Any OpenAI-compatible endpoint (self-hosted vLLM/SGLang in-region, e.g.
# SEA-LION) — referenced as compat-<name>:<model>, here compat-sealion:…
AI_COMPAT_SEALION_BASE_URL=
AI_COMPAT_SEALION_API_KEY=
# Structured output uses json_schema; set false for servers that only support json_object.
# AI_COMPAT_SEALION_STRUCTURED_OUTPUTS=false

# Gateway path overrides per provider (default table in src/models/providers.ts).
# AI_GATEWAY_PATH_ANTHROPIC=anthropic/v1

AI_MODEL_TIMEOUT_MS=60000
# Pictures (DAM "Generate", the copilot's generate_image): openai:gpt-image-1 or compat-<name>:<model>.
# No credentials for the provider = generation off.
AI_MODEL_IMAGE=openai:gpt-image-1
AI_IMAGE_TIMEOUT_MS=150000
AI_DAILY_IMAGE_LIMIT_PER_ORG=20
# Run quota: starts are counted from ai_run_starts (kept when a chat is deleted) and checked +
# reserved under a per-org lock, so deleting chats or firing starts in parallel does not get past it.
AI_DAILY_RUN_LIMIT_PER_ORG=50
AI_RUNS_PER_MINUTE_PER_USER=6
# Copilot requests working at once (planning / running / applying), per person and per shop workspace;
# a start beyond either waits in a FIFO queue (shown in the chat) instead of being refused. 0 = no cap.
AI_MAX_RUNNING_RUNS_PER_USER=3
AI_MAX_RUNNING_RUNS_PER_ORG=3
# A queued start checks for a free slot this often, and waits at most this long (also capped so the
# wait + AI_RUN_BUDGET_MS stays within 290 s: 90 s with the default 200 s budget), then fails "The AI is busy…".
AI_QUEUE_POLL_MS=1500
AI_QUEUE_MAX_WAIT_MS=90000
AI_DAILY_TASK_LIMIT_PER_ORG=500
# Copilot run budget. Model time per request (from its start; inside Vercel's 300 s maxDuration):
# each call's timeout is cut to what is left, and no call or fallback starts with under 20 s left.
AI_RUN_BUDGET_MS=200000
# Input + output tokens one run may use across its model calls; above it no new call starts.
AI_RUN_TOKEN_BUDGET=600000
# Output tokens per copilot model call.
AI_MAX_OUTPUT_TOKENS=8192
# Document text (PDF/CSV/XLSX) on one message across its files (8 000 per file); the rest is cut.
AI_TURN_DOCUMENT_CHARS=60000

OPENROUTER_API_KEY=
# Local dev without keys: AI_MODEL_BALANCED=mock:copilot (refused in production).

# ── Copilot questions ───────────────────────────────────────────
# prime-web origin for the agent tool facade (/api/agent-tools/*): the shop's
# families, attribute schemas and media, read with the merchant's own access.
PRIME_WEB_INTERNAL_URL=http://localhost:3000
# TypeSafe System One (JEV) decision model — ranks the shop's options and
# answers a question itself when confident. Unset = options ordered only.
TYPESAFE_API_KEY=
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_TIMEOUT_MS=15000
# AI_DECISION_AUTO_CONFIDENCE=0.85
# AI_DECISION_CACHE_TTL_DAYS=7

# ── Vercel (serverless) ─────────────────────────────────────────
# VERCEL=1 is set by Vercel itself; it switches on the defaults below. Never set it locally.
# Bearer secret Vercel Cron sends to GET /internal/cron/thread-retention (≥16 chars; Vercel
# adds it as `Authorization: Bearer $CRON_SECRET` when this env var exists). Unset = endpoint refuses.
CRON_SECRET=
# pg pool per instance. Default 5 locally, 3 on Vercel; waiting for a connection fails after 5 s,
# idle connections close after 10 s. Use Neon's *pooled* (-pooler) URL for
# AI_PLATFORM_DATABASE_URL there so many warm instances do not exhaust the database.
# AI_PLATFORM_DB_POOL_MAX=3
# Attachment upload limits. Default 16 MiB body / 10 MB file locally; 4.4 MB / 3 MB on Vercel
# (platform request-body cap is 4.5 MB, base64 grows a file by a third).
# AI_ATTACHMENT_BODY_LIMIT_BYTES=16777216
# AI_ATTACHMENT_MAX_BYTES=10485760
# How often a working run checks whether Stop was pressed on another instance.
# AI_RUN_CANCEL_POLL_MS=1500
# true = also stop a run when the browser closes its SSE stream (default false: the chat restores
# a run that outlived a reload, so closing the tab does not kill it).
# AI_ABORT_RUN_ON_DISCONNECT=false

# ── Copilot capabilities ────────────────────────────────────────
# What the copilot may do here: comma list (src/config/capabilities.ts; README has the tool map).
# This service serves Prime Web only: unset = the Prime Web set below; product_master, inventory and
# store_products (the Product Master world of rewrite/v1) are refused at startup.
# AI_AGENT_CAPABILITIES=site,blog,stock_photos,media_library,image_generation,shop_products,store_categories,store_discounts,store_orders,store_customers,campaigns,store_reports
# A run still "running" in the database after this long was killed by the platform (Vercel
# maxDuration is 300 s); the stale-run sweeps mark it failed. Keep it above the longest run.
# Default 600000 locally, 330000 on Vercel.
# AI_RUN_MAX_RUNNING_MS=600000
# Chat requests (thread list / open, work queue, run start) also close such runs, at most once per
# this long per process, in the background (Vercel Cron is daily and does not run on staging). 0 = off.
# AI_STALE_SWEEP_EVERY_MS=60000
# One JSON log line per request ({reqId, method, route, status, ms, org}; never tokens, bodies or
# headers): `default` logs failures (status >= 400) and requests over 2 s, `all` logs every request.
# Requests carry x-request-id (the caller's when it is 8-128 safe characters, else a new uuid).
# AI_LOG_REQUESTS=default

# ── Cost ────────────────────────────────────────────────────────
# Copilot tool routing: on (default) sends only the tool groups a message needs (page, record and
# keywords pick them; the model loads more with use_tools); off sends every tool, as before.
# AI_TOOL_ROUTING=on
# Next-message suggestions: rules (default: from what the run did, one tiny FAST-model call only
# when no rule fits), model (always that tiny call), off.
# AI_SUGGEST_MODE=rules
# Global daily AI spend cap in USD (every org; the day is Malaysia time; summed from the ledger's
# per-call cost, checked once a minute per instance). Above it runs and tasks answer 503
# "AI is paused for today, it will be back tomorrow." Unset = off.
# AI_DAILY_BUDGET_USD=50
