# PrimeWeb — QC Test Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# QC-only environment. Isolated Neon project + Vercel custom env `qc-test`.
# DUMMY DATA ONLY. Do NOT reuse production/staging credentials here.
# ─────────────────────────────────────────────────────────────────────────────
# Source of truth: Vercel Dashboard → Project → Settings → Environment
# Variables → scope `qc-test`. This file is a placeholder-only reference for
# `scripts/check-env-vars.js` and QC lead runbook.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=qc-test
APP_ENV=qc-test

# ── Database (Neon QC project, ISOLATED) ────────────────────────────────────
# Neon project: ech-prime-web-v2-qc-test (Singapore, Free tier initially)
# Full connection string stored in 1Password vault "PrimeWeb QC".
DATABASE_URI=postgresql://neondb_owner:REPLACE_ME@ep-XXX-qc.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Next.js public URLs (QC scope) ──────────────────────────────────────────
# If custom domain configured (Phase 02 Step 7):
NEXT_PUBLIC_SERVER_URL=https://qc-test.web-v2.dev.ecommercehub.my
NEXT_PUBLIC_PLATFORM_DOMAIN=web-v2.dev.ecommercehub.my
NEXT_PUBLIC_ADMIN_DOMAIN=qc-test.web-v2.dev.ecommercehub.my
# Otherwise fall back to Vercel-generated URL — set in Vercel Dashboard.

# ── Payload CMS (share JWT secret with staging OR isolate) ─────────────────
PAYLOAD_SECRET=REPLACE_ME_QC_ONLY_SECRET
SSO_SHARED_SECRET=
PAYLOAD_PUSH_SCHEMA=false

# ── SSO Integration (share staging backend, QC data isolated at app layer) ─
SSO_FORGOT_PASSWORD_URL=https://sso.dev.ecommercehub.my/auth/forgot-password
SSO_RATE_LIMIT_PER_MIN=300
ALLOWED_ORIGINS=https://qc-test.web-v2.dev.ecommercehub.my
SSO_API_BASE_URL=https://sso-api.dev.ecommercehub.my
SSO_ENCRYPTION_KEY=REPLACE_ME_QC_ENCRYPTION_KEY

# ── Stripe (test keys — same as staging OK) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Xendit (F34) — sandbox key, share with staging ─────────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ── OpenAI (share OR separate for cost tracking during load test) ─────────
OPENAI_API_KEY=sk-...

# ── Pixabay (share) ────────────────────────────────────────────────────────
PIXABAY_API_KEY=
ENABLE_DALLE_HERO=false
PIXABAY_BLOCKS=all
PIXABAY_FALLBACK_ONLY=
GEN_MODE=

# ── S3 / Storage (SHARE endpoint, ISOLATED bucket) ─────────────────────────
# QC-specific bucket so JMeter uploads never contaminate staging/prod media.
S3_BUCKET=tm-prime-web-qc
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_REGION=sgp1
NEXT_PUBLIC_S3_ENDPOINT=${S3_ENDPOINT}

# ── Cloudflare (Custom Domains) — share with staging ───────────────────────
CLOUDFLARE_API_TOKEN=REPLACE_ME
CLOUDFLARE_ZONE_ID=REPLACE_ME

# ── Lark Bot (share with staging OK — QC does not post to prod chats) ──────
LARK_APP_ID=cli_xxxxx
LARK_APP_SECRET=xxxxx
LARK_ENCRYPT_KEY=xxxxx
LARK_VERIFICATION_TOKEN=xxxxx
LARK_BOT_OPEN_ID=ou_xxxxx

# ── GitHub API — reuse staging token ───────────────────────────────────────
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=primeproduction/ech-prime-web-v2

# ── ECH Distribution API (share) ───────────────────────────────────────────
ECH_DISTRIBUTION_API_URL=https://api.ech.com
ECH_DISTRIBUTION_API_KEY=REPLACE_ME

# ── Email (SMTP AWS SES) — share with staging OR mute for QC ───────────────
# Suggest MUTE: MAIL_FROM_ADDRESS pointing to a black-hole address to avoid
# JMeter accidentally spamming a real inbox during load tests.
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_FROM_NAME="Web Store QC"
MAIL_FROM_ADDRESS="no-reply-qc@admin.ecommercehub.unifi.com.my"

# ── Bootstrap Seed (QC-only accounts, dummy passwords) ─────────────────────
# All passwords sourced from 1Password vault "PrimeWeb QC" — do NOT commit
# real values. The seed script `scripts/seed-qc-data.ts` reads
# QC_SEED_PASSWORD and hard-fails if missing (>=8 chars required).
BOOTSTRAP_ADMIN_EMAIL=qc-admin-1@primeweb.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_FROM_VAULT
SSO_SERVICE_EMAIL=qc-sso-service@primeweb.local
SSO_SERVICE_PASSWORD=REPLACE_FROM_VAULT
# Shared password applied to all QC test accounts by seed-qc-data.ts.
# Rotate quarterly (see docs/qa/qc-test-runbook.md).
QC_SEED_PASSWORD=REPLACE_FROM_VAULT

# Number of merchant tenants to seed. Defaults to 5 (baseline, backward
# compatible). Set 300 for capacity/load tests. Clamped to [5, 1000].
# Each merchant gets: 1 owner user, 1 tenant, 1 active plan-subscription
# (Starter/Standard/Professional rotated), 1 bare site + home page, and
# the standard product/extra-page seed pack from qc-seed-products.ts.
# Run via `npm run db:seed-qc-scaled` (sets 300 automatically).
QC_MERCHANT_COUNT=5

# ── QC OTP bypass (in-house test only — NEVER set on production scope) ────
# Triple-guarded in src/lib/otp/qc-bypass.ts:
#   1. APP_ENV === 'qc-test'          (Vercel scope stamp)
#   2. QC_OTP_BYPASS_ENABLED === true  (explicit opt-in)
#   3. email endsWith QC_OTP_BYPASS_DOMAIN  (user-space restrict)
# All three must hold before bypass activates.
QC_OTP_BYPASS_ENABLED=true
QC_OTP_BYPASS_DOMAIN=@primeweb.local
QC_OTP_BYPASS_CODE=123456

# ── QC load-test rate-limit bypass (in-house perf testing only) ──────────────
# Lets single-IP k6 load tests measure REAL app throughput instead of the
# IP rate-limiter (which caps ~30-60 req/60s/IP and dominates single-machine runs).
# Guard in src/lib/rateLimit.ts — both must hold:
#   1. APP_ENV === 'qc-test'                  (Vercel scope stamp)
#   2. QC_RATELIMIT_BYPASS_ENABLED === 'true'  (explicit opt-in)
# NEVER set 'true' on staging/production scope.
QC_RATELIMIT_BYPASS_ENABLED=true

# ── Cron Jobs ──────────────────────────────────────────────────────────────
CRON_SECRET=REPLACE_ME_QC_CRON_SECRET

# ── Web Push Notifications (F16-07) — share with staging OK ───────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:qc@primeweb.local

# ── Upstash Redis (SHARE with staging — namespaced by APP_ENV prefix) ─────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ── E2E Testing / JMeter test credentials (via 1Password vault) ───────────
TEST_EMAIL=qc-owner-1@primeweb.local
TEST_PASSWORD=REPLACE_FROM_VAULT
E2E_TEST_OTP_CODE=REPLACE_ME
E2E_SETUP_SECRET=REPLACE_ME

# ── F19 Vercel Domain Provisioning ─────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_H3WAlHhz2xqvIFRcxfWevPTs
VERCEL_PROJECT_ID=prj_84DQ47BSv2hBX28w0FzjFScfbuRr
VERCEL_APEX_A_RECORD=76.76.21.21
VERCEL_CNAME_TARGET=cname.vercel-dns.com
NEXT_PUBLIC_VERCEL_APEX_IP=76.76.21.21
NEXT_PUBLIC_VERCEL_CNAME_TARGET=cname.vercel-dns.com

# ── AI Generation Monitoring — reduced capture for QC load test ────────────
ADMIN_GEN_CAPTURE_MODE=truncated
ADMIN_GEN_SNAPSHOT_MAX_KB=20

# ── Sentry — separate environment tag for QC noise ─────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=qc-test
NEXT_PUBLIC_SENTRY_ENVIRONMENT=qc-test
