# PrimeWeb Environment Variables
# Copy this file to .env.local and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URI=REPLACE_WITH_YOUR_DATABASE_URI

# ── Payload CMS ────────────────────────────────────────────────────────────
PAYLOAD_SECRET=REPLACE_WITH_YOUR_PAYLOAD_SECRET
# Optional — peer service's PAYLOAD_SECRET for cross-service SSO JWT verification.
# Leave empty unless JWTs from a sibling Payload deployment must be accepted.
SSO_SHARED_SECRET=

# ── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3005

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── OpenAI (AI Generation) ───────────────────────────────────────────────────
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# ── Pixabay (AI Gen — Primary Image Source) ────────────────────────────────
# Register at https://pixabay.com/api/docs/ → copy API key
# Free tier ~100 req/60s (≈6000/hr). largeImageURL (1280px) available.
# Preferred: comma-separated keys are rotated per request. Keep API_KEY for legacy fallback.
PIXABAY_API_KEYS=
PIXABAY_API_KEY=

# Feature flag: "true" = DALL-E hero (legacy, $0.04/gen). "false" = Pixabay (free).
# Default false.
ENABLE_DALLE_HERO=false

# ── S3 / Storage (MinIO or AWS S3) ──────────────────────────────────────────
S3_BUCKET=primeweb-media
S3_ACCESS_KEY_ID=REPLACE_WITH_YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_S3_SECRET_ACCESS_KEY
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-southeast-1
NEXT_PUBLIC_S3_ENDPOINT=http://localhost:9000

# ── Cloudflare (Custom Domains) ──────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=your-zone-id

# ── Platform Config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_PLATFORM_DOMAIN=primeweb.app
NEXT_PUBLIC_ADMIN_DOMAIN=admin.primeweb.app

# ── Lark Bot (Internal Team Assistant) ──────────────────────────────────────
LARK_APP_ID=cli_xxxxx
LARK_APP_SECRET=REPLACE_WITH_YOUR_LARK_APP_SECRET
LARK_ENCRYPT_KEY=xxxxx
LARK_VERIFICATION_TOKEN=REPLACE_WITH_YOUR_LARK_VERIFICATION_TOKEN
LARK_BOT_OPEN_ID=ou_xxxxx
# LARK_API_BASE=https://open.larksuite.com/open-apis  # Default for Lark (use https://open.feishu.cn/open-apis for Feishu)

# ── GitHub API (for Lark Bot CI/PR features) ────────────────────────────────
GITHUB_TOKEN=REPLACE_WITH_YOUR_GITHUB_TOKEN
GITHUB_REPO=nicenathapong/ech-prime-web-v2

# ── Centralised Distribution API (from existing ECH system) ─────────────────
ECH_DISTRIBUTION_API_URL=https://api.ech.com
ECH_DISTRIBUTION_API_KEY=REPLACE_WITH_YOUR_ECH_DISTRIBUTION_API_KEY

# ── Email (SMTP AWS SES) ─────────────────────────────────────────────────────
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_YOUR_MAIL_USERNAME
MAIL_PASSWORD=REPLACE_WITH_YOUR_MAIL_PASSWORD
MAIL_FROM_NAME="Web Store"
MAIL_FROM_ADDRESS="no-reply-web-dev@admin.ecommercehub.unifi.com.my"

# ── SSO Integration ──────────────────────────────────────────────────────────
SSO_FORGOT_PASSWORD_URL=REPLACE_WITH_YOUR_SSO_FORGOT_PASSWORD_URL
# Backend API base URL (NOT the frontend portal). Used for outbound login + step-status calls.
SSO_API_BASE_URL=https://sso-api.dev.ecommercehub.my
# AES-256 key for encrypting user SSO passwords (keyString field). Generate: openssl rand -hex 32
SSO_ENCRYPTION_KEY=

# ── Bootstrap Seed (auto-creates essential accounts on startup) ──────────────
# db-setup.js creates user rows (email + role) on startup.
# Passwords are set via `npm run db:seed-sso` (Payload Local API).
# See docs/DB-LIFECYCLE.md for the 3-layer rule.
BOOTSTRAP_ADMIN_EMAIL=admin@primeweb.app
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_YOUR_BOOTSTRAP_ADMIN_PASSWORD
SSO_SERVICE_EMAIL=sso-service@primeweb.app
SSO_SERVICE_PASSWORD=REPLACE_WITH_YOUR_SSO_SERVICE_PASSWORD

# ── Cron Jobs ────────────────────────────────────────────────────────────────
CRON_SECRET=REPLACE_WITH_YOUR_CRON_SECRET

# ── Web Push Notifications (F16-07) ──────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:adminprimeweb@yopmail.com

# ── E2E Testing (local dev only) ─────────────────────────────────────────────
TEST_EMAIL=admin@primeweb.app
TEST_PASSWORD=REPLACE_WITH_YOUR_TEST_PASSWORD
E2E_TEST_OTP_CODE=your-e2e-otp-code

# ── F19 Vercel Domain Provisioning (replaces DO_API_TOKEN, DO_APP_ID, SERVER_IP) ─
# Token from https://vercel.com/account/settings/tokens (team-scoped)
VERCEL_TOKEN=
# From .vercel/project.json orgId / projectId, or `vercel project ls`
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# F39 Runtime Logs read uses the same team/project IDs above (server-only).
# DNS targets Vercel expects (override only if Vercel changes constants)
VERCEL_APEX_A_RECORD=76.76.21.21
VERCEL_CNAME_TARGET=cname.vercel-dns.com
# Client-side mirrors for DNS instructions UI
NEXT_PUBLIC_VERCEL_APEX_IP=76.76.21.21
NEXT_PUBLIC_VERCEL_CNAME_TARGET=cname.vercel-dns.com

# ── F39 Sentry Runtime Read API (server-only) ────────────────────────────────
# Dedicated least-privilege token with event:read. Never expose as NEXT_PUBLIC_*.
SENTRY_READ_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=production

# REMOVED 2026-04-13: replaced by VERCEL_* vars above
# SERVER_IP, NEXT_PUBLIC_SERVER_IP, DO_API_TOKEN, DO_APP_ID, NEXT_PUBLIC_CNAME_TARGET
