# PrimeWeb Environment Variables
# Copy this file to .env.local and fill in your values

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://postgres:password@localhost:5432/primeweb

# ── Payload CMS ────────────────────────────────────────────────────────────
PAYLOAD_SECRET=your-super-secret-payload-key-change-this-in-production

# ── Next.js ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── OpenAI (AI Generation) ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── S3 / Storage (MinIO or AWS S3) ──────────────────────────────────────────
S3_BUCKET=primeweb-media
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-southeast-1

# ── Cloudflare (Custom Domains) ──────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# ── Platform Config ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_PLATFORM_DOMAIN=primeweb.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Centralised Distribution API (from existing ECH system) ─────────────────
ECH_DISTRIBUTION_API_URL=https://api.ech.com
ECH_DISTRIBUTION_API_KEY=your-ech-api-key
