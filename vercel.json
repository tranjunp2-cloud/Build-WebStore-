{
  "buildCommand": "node scripts/db-setup.js --migrate-only && next build",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/(payload)/api/[...slug]/route.ts": {
      "maxDuration": 60
    },
    "src/app/(payload)/admin/[[...segments]]/page.tsx": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "*/4 * * * *"
    }
  ]
}
